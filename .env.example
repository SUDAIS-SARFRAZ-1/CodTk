# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Required for the contact form to actually send email (app/contact/api/route.ts).
# Get a key at https://resend.com — until this is set, the form will
# validate/spam-check correctly but fail to send with a clear error.
RESEND_API_KEY=

# Sender for lead emails. Must be on a domain verified in Resend (codtk.com).
# Unset = Resend's sandbox sender, which only delivers to the Resend account owner.
RESEND_FROM="CodTK Website <website@codtk.com>"

# Cloudflare Turnstile (spam check on the contact form). Create a widget for codtk.com at
# https://dash.cloudflare.com/?to=/:account/turnstile. Unset = no captcha (local dev only).
# Cloudflare's always-pass test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Canonical site URL for metadata, sitemap and robots. Defaults to https://codtk.com.
NEXT_PUBLIC_SITE_URL=
